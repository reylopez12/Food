diff --git a/lib/check-depth.js b/lib/check-depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..4f9579ff9bc794b1f12595755ec3894330f610b5
--- /dev/null
+++ b/lib/check-depth.js
@@ -0,0 +1,25 @@
+'use strict';
+
+// Check iteratively before any recursive AST walker, including caller-built ASTs.
+module.exports = ast => {
+  const pending = [{ node: ast, depth: 0, exit: false }];
+  const ancestors = new Set();
+  while (pending.length) {
+    const { node, depth, exit } = pending.pop();
+    if (!node || typeof node !== 'object') continue;
+    if (exit) {
+      ancestors.delete(node);
+      continue;
+    }
+    if (depth > 100 || ancestors.has(node)) {
+      throw new SyntaxError('Brace AST exceeds maximum nesting depth (100) or contains a cycle');
+    }
+    if (Array.isArray(node.nodes)) {
+      ancestors.add(node);
+      pending.push({ node, depth, exit: true });
+      for (const child of node.nodes) {
+        pending.push({ node: child, depth: depth + 1, exit: false });
+      }
+    }
+  }
+};
