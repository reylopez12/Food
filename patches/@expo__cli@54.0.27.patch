--- /dev/null
+++ b/build/src/start/server/metro/metroFileMapEvents.js
@@ -0,0 +1,14 @@
+"use strict";
+const path = require('path');
+
+// Preserve SDK 54 watcher APIs across Metro's security patch release.
+exports.getEventsQueue = ({ eventsQueue, changes, rootDir }) => {
+    if (eventsQueue) return eventsQueue;
+    const events = [];
+    for (const [key, type] of [['addedFiles', 'add'], ['modifiedFiles', 'change'], ['removedFiles', 'delete']]) {
+        for (const [filePath] of changes[key]) {
+            events.push({ type, filePath: path.resolve(rootDir, filePath) });
+        }
+    }
+    return events;
+};
